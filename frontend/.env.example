# Environment Variables for Frontend
# In production on Vercel, set VITE_API_URL to your Render backend API URL:
VITE_API_URL=https://smart-library-management-and-book.onrender.com/api

# For local development against a local FastAPI backend (http://127.0.0.1:8000),
# leave VITE_API_URL unset so the Vite development server proxy handles /api -> http://127.0.0.1:8000
